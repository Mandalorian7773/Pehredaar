<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dictating rules in Hindi via SpeechRecognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- LAN only: reaching the RTSP camera. No cloud endpoints are contacted anywhere in this app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Pehredaar"
        android:icon="@android:drawable/ic_menu_view"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pehredaar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pehredaar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PipelineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
